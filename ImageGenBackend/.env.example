# Copy to .env and fill in secrets. Defaults below match config/settings.py.

ENVIRONMENT=local
IP_ADDRESS=localhost
NAME_APP=image_gen
BASE_URL=
STORAGE_PATH=storage/

# Mongo
MONGO_URI=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_PREFIX_KEY=image_gen

# Storage (remote file server) TMTFileServers
# FILE_SERVER_MODE: 'local' (default, no external dependency) or 'remote'.
# Remote-only operations (store_remote, store_video_remote, upload_image) raise
# RemoteStorageDisabledError instead of calling out when this is 'local'.
FILE_SERVER_MODE=local
FILE_SERVER_SERVICE_NAME=
FILE_SERVER_APP_ID=
FILE_SERVER_SECRET=
FILE_SERVER_APP_FOLDER=
FILE_SERVER_BASE_URL=https://
FILE_SERVER_TENANT_ID=image_gen
FILE_SERVER_ROOT_DIRECTORY_NAME=ImageGen

# Job limits (per-lane concurrency)
LIMIT_FAST_JOB=10
LIMIT_MEDIUM_JOB=10
LIMIT_SLOW_JOB=10

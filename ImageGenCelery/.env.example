# Copy to .env and fill in. Values shown are the code defaults (config/config.py) —
# uncomment / edit only what needs to differ from that default.

# --- Core ---
ENVIRONMENT=local
NAME_APP=image_gen
MODEL_PATH=/TMTAI/AI_MemBer/nhlinh/StableDiffusion/DiffusionService/checkpoints/model
STORAGE_PATH=storage/
# 'local' (default) or 'remote' -- Celery has no FILE_SERVER_* credential fields,
# so 'remote' isn't actually usable here; kept only so the shared StorageManager
# (common_lib.storage) resolves a mode the same way as ImageGenBackend.
FILE_SERVER_MODE=local

# --- Mongo (shared with ImageGenBackend via CommonLib) ---
MONGO_URI=

# --- Redis ---
REDIS_HOST=172.29.32.24
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_PREFIX_KEY=image_gen

# --- RabbitMQ ---
RABBITMQ_HOST=172.29.32.24
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_PORT=5672
RABBITMQ_VHOST=tuannha

# --- Job lanes (config.job_limits) ---
LIMIT_FAST_JOB=10
LIMIT_MEDIUM_JOB=10
LIMIT_SLOW_JOB=10
